# Autonomous Trend Intelligence Engine - Environment Configuration

# OpenAI API Configuration
OPENAI_API_KEY=your-openai-api-key-here
LLM_MODEL=gpt-4
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=4000

# GitHub API Configuration
GITHUB_TOKEN=your-github-token-here

# Hugging Face API Configuration
HUGGINGFACE_TOKEN=your-huggingface-token-here

# Engine Configuration
VERBOSE=true
MAX_WORKERS=4
REQUEST_TIMEOUT=60

# Output Configuration
OUTPUT_DIR=outputs/
CACHE_ENABLED=true
CACHE_TTL_HOURS=24

# Trend Detection Thresholds
SPIKE_THRESHOLD=1.5
MIN_CONFIDENCE=0.6
MIN_DATA_POINTS=7
BASELINE_WINDOW_DAYS=30

# Viability Scoring Thresholds
PRODUCTION_THRESHOLD=0.8
PROMISING_THRESHOLD=0.6
EXPERIMENTAL_THRESHOLD=0.4

# Source Limits
HUGGINGFACE_LIMIT=50
GITHUB_LIMIT=100
COMMUNITY_MIN_ENGAGEMENT=10

# Retry Configuration
REQUEST_BACKOFF_BASE=2.0
REQUEST_MAX_RETRIES=3
