### Get all users
GET http://localhost:5025/users
Accept: application/json

###

### Get user by ID
GET http://localhost:5025/users/1
Accept: application/json

###

### Create a new user
POST http://localhost:5025/users
Content-Type: application/json

{
  "name": "Khan",
  "email": "khan@techhive.com",
  "department": "IT",
  "role": "Developer"
}

###

### Update an existing user
PUT http://localhost:5025/users/1
Content-Type: application/json

{
  "id": 1,
  "name": "K.",
  "email": "k.@techhive.com",
  "department": "IT",
  "role": "Senior Developer"
}

###

### Delete a user
DELETE http://localhost:5025/users/1


# 🧪 Get All Users (Valid Token)
GET http://localhost:5025/users
Authorization: Bearer secret-token-123
Accept: application/json

###

# 🚫 Get All Users (Missing Token)
GET http://localhost:5025/users
Accept: application/json

###

# 🧪 Create a Valid User
POST http://localhost:5025/users
Authorization: Bearer secret-token-123
Content-Type: application/json

{
  "name": "Zaid",
  "email": "zaid@techhive.com",
  "department": "HR",
  "role": "Recruiter"
}

###

# 🚫 Create a User with Invalid Email
POST http://localhost:5025/users
Authorization: Bearer secret-token-123
Content-Type: application/json

{
  "name": "Zaad",
  "email": "invalid-email",
  "department": "HR",
  "role": "Recruiter"
}

###

# 🧪 Retrieve Non-Existent User (Triggers 404)
GET http://localhost:5025/users/999
Authorization: Bearer secret-token-123
Accept: application/json

###

# 🚫 Unauthorized Delete Attempt
DELETE http://localhost:5025/users/1

###

# ✅ Valid Delete Request
DELETE http://localhost:5025/users/1
Authorization: Bearer secret-token-123